#!/usr/bin/env bash
# Lightweight shopper launcher. Uses the COMPOSED BASE's own python3 (every sbx
# base provides one) — no venv, no relocated interpreter, so nothing dangles
# when this overlay lands on a different base.
#
#   shop "<task>" <url>
#
# Prints a JSON trace of the shopper's verdict to stdout.
set -euo pipefail
exec python3 /opt/browser-use/shopper.py "$@"
